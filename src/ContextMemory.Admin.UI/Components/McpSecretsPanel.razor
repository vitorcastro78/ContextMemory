@using ContextMemory.Core.Agentic

<div class="border rounded bg-light p-2 mt-2">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <strong class="small mb-0">Stored secrets</strong>
        <div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleReveal" disabled="@(_form is null)">
                <i class="fas @(_reveal ? "fa-eye-slash" : "fa-eye")"></i>
                @(_reveal ? "Hide" : "Show")
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">
                Reload
            </button>
        </div>
    </div>
    <FieldHelp>
        Lives in <code>mcp_credentials</code>, not ConfigJson. Save here — <strong>Save agentic</strong> does not persist these values.
    </FieldHelp>

    @if (_loading)
    {
        <p class="text-muted small mb-0"><i class="fas fa-spinner fa-spin"></i> Loading secrets…</p>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger mb-0 py-1 small">@_error</div>
    }
    else if (_form is not null)
    {
        @if (_message is not null)
        {
            <div class="alert alert-success py-1 small">@_message</div>
        }
        @if (!_hasStored)
        {
            <p class="text-muted small">No stored secret for this credential ref yet. Fill and save to create one.</p>
        }
        else
        {
            <p class="text-muted small mb-2">Updated @_form.UpdatedAt.ToUniversalTime().ToString("u")</p>
        }

        <div class="form-row">
            <div class="col-md-4 form-group mb-2">
                <label>Credential ref</label>
                <InputText class="form-control form-control-sm" @bind-Value="_form.CredentialRef" />
            </div>
            <div class="col-md-4 form-group mb-2">
                <label>Auth mode</label>
                <InputSelect class="form-control form-control-sm" @bind-Value="_form.AuthMode">
                    <option value="env">env</option>
                    <option value="bearer">bearer</option>
                    <option value="api-key">api-key</option>
                    <option value="oauth-per-tenant">oauth-per-tenant</option>
                </InputSelect>
            </div>
        </div>

        @if (_form.AuthMode == "env" || string.IsNullOrWhiteSpace(_form.AuthMode))
        {
            <div class="form-group mb-2">
                <label>Env (KEY=value per line)</label>
                @if (_reveal)
                {
                    <InputTextArea class="form-control form-control-sm font-monospace" rows="4"
                                   @bind-Value="_form.EnvText"
                                   placeholder="ZUORA_BASE_URL=https://&#10;ZUORA_CLIENT_ID=&#10;ZUORA_CLIENT_SECRET=" />
                }
                else
                {
                    <pre class="form-control form-control-sm font-monospace mb-0" style="min-height:6rem;white-space:pre-wrap">@MaskedEnvPreview</pre>
                    <span class="text-muted small">Click Show to reveal and edit values.</span>
                }
            </div>
        }
        @if (_form.AuthMode == "bearer")
        {
            <div class="form-group mb-2">
                <label>Bearer token</label>
                <input class="form-control form-control-sm font-monospace"
                       type="@(_reveal ? "text" : "password")"
                       @bind="_form.BearerToken" />
            </div>
        }
        @if (_form.AuthMode == "api-key")
        {
            <div class="form-row">
                <div class="col-md-4 form-group mb-2">
                    <label>Header name</label>
                    <InputText class="form-control form-control-sm" @bind-Value="_form.HeaderName" />
                </div>
                <div class="col-md-8 form-group mb-2">
                    <label>API key</label>
                    <input class="form-control form-control-sm font-monospace"
                           type="@(_reveal ? "text" : "password")"
                           @bind="_form.ApiKey" />
                </div>
            </div>
        }
        @if (_form.AuthMode == "oauth-per-tenant")
        {
            <div class="form-row">
                <div class="col-md-6 form-group mb-2">
                    <label>Token URL</label>
                    <InputText class="form-control form-control-sm" @bind-Value="_form.TokenUrl" />
                </div>
                <div class="col-md-6 form-group mb-2">
                    <label>Scope</label>
                    <InputText class="form-control form-control-sm" @bind-Value="_form.Scope" />
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-4 form-group mb-2">
                    <label>Client ID</label>
                    <input class="form-control form-control-sm font-monospace"
                           type="@(_reveal ? "text" : "password")"
                           @bind="_form.ClientId" />
                </div>
                <div class="col-md-4 form-group mb-2">
                    <label>Client secret</label>
                    <input class="form-control form-control-sm font-monospace"
                           type="@(_reveal ? "text" : "password")"
                           @bind="_form.ClientSecret" />
                </div>
                <div class="col-md-4 form-group mb-2">
                    <label>Audience</label>
                    <InputText class="form-control form-control-sm" @bind-Value="_form.Audience" />
                </div>
            </div>
        }

        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Saving secrets…" : "Save secrets")
        </button>
    }
</div>

@code {
    [Parameter] public string AppId { get; set; } = string.Empty;
    [Parameter] public string IntegrationName { get; set; } = string.Empty;
    [Parameter] public string? CredentialRef { get; set; }

    [Inject] private AdminApiClient Api { get; set; } = default!;

    private SecretForm? _form;
    private bool _loading = true;
    private bool _saving;
    private bool _reveal;
    private bool _hasStored;
    private string? _error;
    private string? _message;
    private string _loadedKey = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{AppId}|{IntegrationName}|{CredentialRef}";
        if (key == _loadedKey && _form is not null)
            return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _message = null;
        _hasStored = false;
        _form = null;
        try
        {
            if (string.IsNullOrWhiteSpace(AppId) || string.IsNullOrWhiteSpace(IntegrationName))
            {
                _form = NewForm();
                return;
            }

            var rows = await Api.GetMcpCredentialsAsync(AppId, IntegrationName);
            var match = rows.FirstOrDefault(r =>
                            !string.IsNullOrWhiteSpace(CredentialRef)
                            && string.Equals(r.CredentialRef, CredentialRef, StringComparison.OrdinalIgnoreCase))
                        ?? rows.FirstOrDefault();
            _hasStored = match is not null;
            _form = match is null ? NewForm() : FromDto(match);
            _loadedKey = $"{AppId}|{IntegrationName}|{CredentialRef}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _form = NewForm();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleReveal() => _reveal = !_reveal;

    private string MaskedEnvPreview
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_form?.EnvText))
                return "(empty)";

            var lines = new List<string>();
            foreach (var line in _form.EnvText.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var idx = line.IndexOf('=');
                lines.Add(idx <= 0 ? "••••••••" : $"{line[..idx]}=••••••••");
            }

            return lines.Count == 0 ? "(empty)" : string.Join('\n', lines);
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null || string.IsNullOrWhiteSpace(AppId) || string.IsNullOrWhiteSpace(IntegrationName))
            return;

        var credRef = string.IsNullOrWhiteSpace(_form.CredentialRef)
            ? (string.IsNullOrWhiteSpace(CredentialRef) ? IntegrationName : CredentialRef)
            : _form.CredentialRef.Trim();

        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await Api.UpsertMcpCredentialAsync(
                AppId,
                IntegrationName,
                new McpCredentialUpsertRequest
                {
                    IntegrationName = IntegrationName,
                    CredentialRef = credRef,
                    AuthMode = string.IsNullOrWhiteSpace(_form.AuthMode) ? "env" : _form.AuthMode,
                    BearerToken = string.IsNullOrWhiteSpace(_form.BearerToken) ? null : _form.BearerToken,
                    ApiKey = string.IsNullOrWhiteSpace(_form.ApiKey) ? null : _form.ApiKey,
                    HeaderName = string.IsNullOrWhiteSpace(_form.HeaderName) ? null : _form.HeaderName,
                    Env = ParseEnv(_form.EnvText),
                    OAuth = string.IsNullOrWhiteSpace(_form.TokenUrl)
                        ? null
                        : new McpOAuthConfig
                        {
                            TokenUrl = _form.TokenUrl.Trim(),
                            ClientId = _form.ClientId,
                            ClientSecret = _form.ClientSecret,
                            Scope = string.IsNullOrWhiteSpace(_form.Scope) ? null : _form.Scope,
                            Audience = string.IsNullOrWhiteSpace(_form.Audience) ? null : _form.Audience
                        }
                });
            await LoadAsync();
            _message = "Secrets saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private SecretForm NewForm() => new()
    {
        CredentialRef = string.IsNullOrWhiteSpace(CredentialRef) ? IntegrationName : CredentialRef,
        AuthMode = "env"
    };

    private static SecretForm FromDto(McpCredentialAdminDto dto) => new()
    {
        CredentialRef = dto.CredentialRef,
        AuthMode = string.IsNullOrWhiteSpace(dto.AuthMode) ? "env" : dto.AuthMode,
        BearerToken = dto.BearerToken ?? string.Empty,
        ApiKey = dto.ApiKey ?? string.Empty,
        HeaderName = dto.HeaderName ?? string.Empty,
        EnvText = FormatEnv(dto.Env),
        TokenUrl = dto.OAuth?.TokenUrl ?? string.Empty,
        ClientId = dto.OAuth?.ClientId ?? string.Empty,
        ClientSecret = dto.OAuth?.ClientSecret ?? string.Empty,
        Scope = dto.OAuth?.Scope ?? string.Empty,
        Audience = dto.OAuth?.Audience ?? string.Empty,
        UpdatedAt = dto.UpdatedAt
    };

    private static Dictionary<string, string>? ParseEnv(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return null;

        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var line in text.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var idx = line.IndexOf('=');
            if (idx <= 0)
                continue;
            map[line[..idx].Trim()] = line[(idx + 1)..].Trim();
        }

        return map.Count == 0 ? null : map;
    }

    private static string FormatEnv(Dictionary<string, string>? env) =>
        env is null || env.Count == 0
            ? string.Empty
            : string.Join('\n', env.Select(kv => $"{kv.Key}={kv.Value}"));

    private sealed class SecretForm
    {
        public string CredentialRef { get; set; } = string.Empty;
        public string AuthMode { get; set; } = "env";
        public string BearerToken { get; set; } = string.Empty;
        public string ApiKey { get; set; } = string.Empty;
        public string HeaderName { get; set; } = string.Empty;
        public string EnvText { get; set; } = string.Empty;
        public string TokenUrl { get; set; } = string.Empty;
        public string ClientId { get; set; } = string.Empty;
        public string ClientSecret { get; set; } = string.Empty;
        public string Scope { get; set; } = string.Empty;
        public string Audience { get; set; } = string.Empty;
        public DateTimeOffset UpdatedAt { get; set; }
    }
}
